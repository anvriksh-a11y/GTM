# Groq API Key (for prompt parsing)
GROQ_API_KEY=your_groq_api_key_here

# SerpAPI Key (for Google Search scraping)
SERPAPI_KEY=your_serpapi_key_here

# Google Maps / Places API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server Config
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Email Verification (Reacher - self-hosted via Docker)
# Run with: docker run -p 8080:8080 reacherhq/check-if-email-exists
REACHER_API_URL=http://localhost:8080

# Cashfree API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=PRODUCTION

# WhatsApp (OpenWA) Config
OPENWA_API_URL=http://localhost:8000
OPENWA_API_KEY=

# Voice TTS Provider & Cartesia
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=your_cartesia_api_key_here

# Cloudflare Workers AI (Image Generation)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here


# Session & Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
